# BEGIN Custom API Storage Rewrites & CORS Headers
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route API storage, products, orders, and customer requests directly to product_storage_handler.php
    RewriteRule ^api/storage/(.*)$ product_storage_handler.php?endpoint=$1 [L,QSA]
    RewriteRule ^api/products/(.*)$ product_storage_handler.php?endpoint=products&id=$1 [L,QSA]
    RewriteRule ^api/products$ product_storage_handler.php?endpoint=products [L,QSA]
    RewriteRule ^api/orders/(.*)$ product_storage_handler.php?endpoint=orders&id=$1 [L,QSA]
    RewriteRule ^api/orders$ product_storage_handler.php?endpoint=orders [L,QSA]
    RewriteRule ^api/customers/(.*)$ product_storage_handler.php?endpoint=customers&id=$1 [L,QSA]
    RewriteRule ^api/customers$ product_storage_handler.php?endpoint=customers [L,QSA]

    # Handle React / SPA front-end routing if frontend files are also hosted on Apache
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteRule ^ index.html [L]
</IfModule>
# END Custom API Storage Rewrites & CORS Headers

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
